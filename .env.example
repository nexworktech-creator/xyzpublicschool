# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/xyz_school?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Cloudinary (Media & Image Hosting)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# App
NEXT_PUBLIC_SITE_NAME="XYZ Public School"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed script (creates first Super Admin) - run: npm run seed
# Default credentials per spec: PIN / Password = 12345
SEED_ADMIN_EMAIL=admin@xyzschool.edu
SEED_ADMIN_PASSWORD=12345
SEED_ADMIN_PIN=12345
